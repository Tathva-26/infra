# Copy to .env (never commit).

# Password must be URL-safe (hex) — it is interpolated into DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_url_safe_password
POSTGRES_DB=tathva # default DB

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

TRUST_PROXY=1

# Monitoring
GRAFANA_ADMIN_PASSWORD=replace_with_strong_password

# Empty = /metrics open inside the compose network only. If set, also add it to
# monitoring/prometheus.yml as `authorization: {type: Bearer, credentials: <token>}`.
METRICS_TOKEN=
