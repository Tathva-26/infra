# Copy to whatsapp.env (never commit).

GEMINI_API_KEY=your_gemini_api_key_here
# Gemini free tier is 5 requests/minute; raise on a paid key.
GEMINI_RPM=5

# Password of the map admin account below. The account must already exist in
# map-api's database (see README); 10 char minimum.
MAP_ADMIN_USER=whatsapp-bot
MAP_ADMIN_PASS=replace_with_bot_account_password

# Prefer the id: matching by id needs no page call.
TARGET_GROUP_ID=0000000000-0000000000@g.us
TARGET_GROUP=

# Optional: pair with a code instead of a QR. Digits only, with country code.
WHATSAPP_PHONE=
