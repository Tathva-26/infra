# Copy to backend-v2.env (never commit). DATABASE_URL and Google OAuth
# credentials come from docker-compose.yml, so they are not listed here.

NODE_ENV=production

LOG_LEVEL=info
TZ=Asia/Kolkata

ALLOWED_ORIGINS=https://tathva.example.com

JWT_SECRET=replace_with_backend_v2_jwt_secret

WEBHOOK_TOKEN=
TIQR_BASE_URL=https://api.tiqr.events
TIQR_API_KEY=
PROPATRADE_URL=

GOOGLE_REDIRECT_URI=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=images
R2_PUBLIC_URL=https://cdn.tathva.org
R2_IMAGE_FOLDER=profile

IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1600
IMAGE_QUALITY=80
IMAGE_MAX_KB=400
IMAGE_MAX_MB=2
