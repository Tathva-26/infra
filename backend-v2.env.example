# Copy to backend-v2.env (never commit).

# --- Runtime ---
NODE_ENV=production
PORT=8000
LOG_LEVEL=info
TZ=Asia/Kolkata

# --- DATABASE ---
# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB set in infra/.env
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/tathva

# --- Redis cache (fail-soft) ---
# REDIS_URL points at the compose "redis" service; change only if Redis lives elsewhere.
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=tathva-main: # REDIS_KEY_PREFIX is mandatory when REDIS_URL is set (boot fails without it).
CACHE_DEFAULT_TTL_SECONDS=300 # Not mandatory

# --- Auth (better-auth, stateless session cookie) ---
# Frontends allowed to call the API (comma-separated) and to start OAuth.
ALLOWED_ORIGINS=https://tathva.example.com
# Public URL of this backend, e.g. https://api.tathva.org
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=replace_with_backend_v2_better_auth_secret
# NOTE: the Google redirect URI sent is {BETTER_AUTH_URL}/api/auth/callback/google.
# Register that exact URI in the Google Cloud Console or sign-in fails with
# redirect_uri_mismatch.

# Where TIQR returns the payer after checkout (single origin, no path).
FRONTEND_URL=https://tathva.example.com

# --- TIQR ticketing ---
TIQR_BASE_URL=https://api.tiqr.events
TIQR_SESSION_ID=
TIQR_HOST_ID= # Not used as of now, but still required at boot

# --- Cloudflare R2 (accommodation/event image uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=images
R2_PUBLIC_URL=https://cdn.tathva.org
R2_IMAGE_FOLDER=profile

# --- Image processing limits ---
# IMAGE_MAX_KB/IMAGE_MAX_MB are hard-ceiled by the app at 400 KB / 1 MB;
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1600
IMAGE_QUALITY=80
IMAGE_MAX_KB=400
IMAGE_MAX_MB=1
