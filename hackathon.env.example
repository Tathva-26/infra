# Copy to hackathon.env (never commit). DATABASE_URL and Google OAuth
# credentials come from docker-compose.yml, so they are not listed here.

NODE_ENV=production
PORT=8080 # must match the published port in docker-compose.yml

# Min 32 chars:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_random_secret_string

FRONTEND_URL=http://localhost:3000

# Optional: if unset, registration/payment routes answer 503.
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

FEE_PER_MEMBER_PAISE=50000
